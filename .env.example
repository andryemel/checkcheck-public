# Copy this file to .env and fill in the values. Never commit .env.

# Required. Create a key at https://openrouter.ai/keys and set a credit limit on it.
OPENROUTER_API_KEY=

# The model is fixed in code to meta/muse-ember; there is no fallback model.
# Search: OpenRouter web_search server tool, Exa engine.
CHECKCHECK_MAX_SEARCHES=3
CHECKCHECK_MAX_OUTPUT_TOKENS=8000
CHECKCHECK_REASONING_EFFORT=low
CHECKCHECK_TIMEOUT_MS=150000

# Public-demo limits.
CHECKS_PER_IP_PER_HOUR=5
DAILY_CHECK_CAP=150
DAILY_SPEND_CAP_USD=5
# Worst-case cost reserved against the daily cap before a check starts (released to the real cost afterwards).
CHECK_RESERVE_USD=0.06

# Storage: "file" (local development, ./data) or "redis" (Upstash-compatible REST API, required on serverless hosts).
STORE_DRIVER=file
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both spellings are read.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Days a shared report stays available.
SHARE_TTL_DAYS=90

# Optional register / list sources. Without a key the report says "not searched".
COMPANIES_HOUSE_API_KEY=
OPENSANCTIONS_API_KEY=

# Public base URL used in share links (no trailing slash). Defaults to the request's own origin.
PUBLIC_BASE_URL=
PORT=8787
